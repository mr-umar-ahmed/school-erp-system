# ---------------------------------------------------------------------------
# Local development (portable PostgreSQL cluster on this machine)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/edunexus

# ---------------------------------------------------------------------------
# Hosted PostgreSQL (Supabase / Neon / Railway) — see DEPLOYMENT.md
# ---------------------------------------------------------------------------
# Runtime uses the POOLED connection (Supabase port 6543):
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# Migrations need the DIRECT connection (port 5432) — poolers can't run DDL.
# Leave DIRECT_URL unset locally; it falls back to DATABASE_URL.
#   DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 64-char random hex used to sign session JWTs.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

# Public base URL of the app (https://<your-app>.vercel.app in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
