// EduNexus — School ERP schema
// Times of day are stored as "HH:mm" strings; date-only values use @db.Date.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  super_admin
  admin
  teacher
  student
  parent
  staff
}

enum Gender {
  male
  female
  other
}

enum AttendanceStatus {
  present
  absent
  late
  half_day
  excused
}

enum FeeStatus {
  paid
  unpaid
  partial
  overdue
  waived
}

enum ExamType {
  unit_test
  midterm
  final
  practical
  assignment
}

enum AdmissionStatus {
  inquiry
  applied
  shortlisted
  accepted
  enrolled
  rejected
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum BookStatus {
  available
  issued
  reserved
  lost
  damaged
}

enum LibraryTxnStatus {
  issued
  returned
  overdue
  lost
}

enum MessageType {
  announcement
  direct
  group
  emergency
}

enum PriorityLevel {
  low
  medium
  high
  urgent
}

enum PayrollStatus {
  pending
  processed
  paid
}

// ---------- Core ----------

model Institution {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  code            String   @unique
  address         String?
  city            String?
  state           String?
  country         String   @default("India")
  phone           String?
  email           String?
  website         String?
  logoUrl         String?
  establishedYear Int?
  board           String? // CBSE, ICSE, State Board, IB, ...
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  academicYears   AcademicYear[]
  classes         SchoolClass[]
  subjects        Subject[]
  attendance      Attendance[]
  timetableSlots  TimetableSlot[]
  examinations    Examination[]
  feeStructures   FeeStructure[]
  transportRoutes TransportRoute[]
  libraryBooks    LibraryBook[]
  hostelRooms     HostelRoom[]
  announcements   Announcement[]
  messages        Message[]
  assignments     Assignment[]
  inventoryItems  InventoryItem[]
  visitorLogs     VisitorLog[]
  gradeScales     GradeScale[]
  storedFiles     StoredFile[]

  @@map("institutions")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  institutionId       String?   @db.Uuid
  role                UserRole  @default(student)
  firstName           String
  lastName            String
  email               String    @unique
  passwordHash        String
  phone               String?
  avatarUrl           String?
  gender              Gender?
  dateOfBirth         DateTime? @db.Date
  address             String?
  city                String?
  state               String?
  isActive            Boolean   @default(true)
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  institution         Institution?         @relation(fields: [institutionId], references: [id])
  student             Student?
  parent              Parent?
  teacher             Teacher?
  staff               Staff?
  attendanceRecords   Attendance[]         @relation("AttendanceUser")
  attendanceMarked    Attendance[]         @relation("AttendanceMarkedBy")
  classTeacherOf      Section[]            @relation("SectionClassTeacher")
  taughtSubjects      ClassSubject[]       @relation("ClassSubjectTeacher")
  timetableSlots      TimetableSlot[]      @relation("TimetableTeacher")
  assignments         Assignment[]         @relation("AssignmentTeacher")
  announcements       Announcement[]       @relation("AnnouncementAuthor")
  sentMessages        Message[]            @relation("MessageSender")
  receivedMessages    Message[]            @relation("MessageRecipient")
  leaveRequests       LeaveRequest[]       @relation("LeaveUser")
  leaveApprovals      LeaveRequest[]       @relation("LeaveApprover")
  payrolls            Payroll[]
  libraryTransactions LibraryTransaction[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  uploadedFiles       StoredFile[]         @relation("StoredFileUploader")

  @@index([institutionId])
  @@index([role])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Academics ----------

model AcademicYear {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  name          String // "2025-2026"
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())

  institution     Institution      @relation(fields: [institutionId], references: [id])
  sections        Section[]
  classSubjects   ClassSubject[]
  students        Student[]
  attendance      Attendance[]
  timetableSlots  TimetableSlot[]
  examinations    Examination[]
  feeStructures   FeeStructure[]
  studentTransport StudentTransport[]
  hostelAllocations HostelAllocation[]

  @@index([institutionId])
  @@map("academic_years")
}

model SchoolClass {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  name          String // "Class 10"
  numericOrder  Int
  createdAt     DateTime @default(now())

  institution   Institution    @relation(fields: [institutionId], references: [id])
  sections      Section[]
  classSubjects ClassSubject[]
  examSchedules ExamSchedule[]
  feeStructures FeeStructure[]
  assignments   Assignment[]

  @@index([institutionId])
  @@map("classes")
}

model Section {
  id             String  @id @default(uuid()) @db.Uuid
  classId        String  @db.Uuid
  name           String // "A"
  capacity       Int     @default(40)
  classTeacherId String? @db.Uuid
  academicYearId String? @db.Uuid
  createdAt      DateTime @default(now())

  schoolClass    SchoolClass     @relation(fields: [classId], references: [id])
  classTeacher   User?           @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])
  academicYear   AcademicYear?   @relation(fields: [academicYearId], references: [id])
  students       Student[]
  timetableSlots TimetableSlot[]
  assignments    Assignment[]

  @@unique([classId, name, academicYearId])
  @@index([classId])
  @@map("sections")
}

model Subject {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  name          String
  code          String
  type          String   @default("core") // core, elective, activity
  createdAt     DateTime @default(now())

  institution    Institution     @relation(fields: [institutionId], references: [id])
  classSubjects  ClassSubject[]
  timetableSlots TimetableSlot[]
  examSchedules  ExamSchedule[]
  assignments    Assignment[]

  @@unique([institutionId, code])
  @@map("subjects")
}

model ClassSubject {
  id             String  @id @default(uuid()) @db.Uuid
  classId        String  @db.Uuid
  subjectId      String  @db.Uuid
  teacherId      String? @db.Uuid
  academicYearId String? @db.Uuid

  schoolClass  SchoolClass   @relation(fields: [classId], references: [id])
  subject      Subject       @relation(fields: [subjectId], references: [id])
  teacher      User?         @relation("ClassSubjectTeacher", fields: [teacherId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@unique([classId, subjectId, academicYearId])
  @@map("class_subjects")
}

// ---------- People ----------

model Student {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @unique @db.Uuid
  admissionNo           String          @unique
  admissionDate         DateTime?       @db.Date
  sectionId             String?         @db.Uuid
  academicYearId        String?         @db.Uuid
  rollNumber            Int?
  bloodGroup            String?
  religion              String?
  nationality           String          @default("Indian")
  previousSchool        String?
  admissionStatus       AdmissionStatus @default(enrolled)
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  section          Section?           @relation(fields: [sectionId], references: [id])
  academicYear     AcademicYear?      @relation(fields: [academicYearId], references: [id])
  parentLinks      ParentStudent[]
  examResults      ExamResult[]
  feePayments      FeePayment[]
  transport        StudentTransport[]
  hostelAllocations HostelAllocation[]
  submissions      AssignmentSubmission[]

  @@index([sectionId])
  @@map("students")
}

model Parent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  occupation   String?
  annualIncome Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentLinks ParentStudent[]

  @@map("parents")
}

model ParentStudent {
  id               String  @id @default(uuid()) @db.Uuid
  parentId         String  @db.Uuid
  studentId        String  @db.Uuid
  relationship     String // father, mother, guardian
  isPrimaryContact Boolean @default(false)

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_students")
}

model Teacher {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  employeeId      String    @unique
  department      String?
  designation     String?
  qualification   String?
  experienceYears Int?
  specialization  String?
  joiningDate     DateTime? @db.Date
  salary          Decimal?  @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teachers")
}

model Staff {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  employeeId  String    @unique
  department  String?
  designation String?
  joiningDate DateTime? @db.Date
  salary      Decimal?  @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff")
}

// ---------- Attendance ----------

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  institutionId  String           @db.Uuid
  userId         String           @db.Uuid
  date           DateTime         @db.Date
  status         AttendanceStatus
  checkInTime    String? // "HH:mm"
  checkOutTime   String? // "HH:mm"
  remarks        String?
  markedById     String?          @db.Uuid
  academicYearId String?          @db.Uuid
  createdAt      DateTime         @default(now())

  institution  Institution   @relation(fields: [institutionId], references: [id])
  user         User          @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  markedBy     User?         @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@unique([userId, date])
  @@index([institutionId, date])
  @@map("attendance")
}

// ---------- Timetable ----------

model TimetableSlot {
  id             String  @id @default(uuid()) @db.Uuid
  institutionId  String  @db.Uuid
  sectionId      String  @db.Uuid
  subjectId      String  @db.Uuid
  teacherId      String  @db.Uuid
  dayOfWeek      Int // 0-6 (Sunday = 0)
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  roomNumber     String?
  academicYearId String? @db.Uuid
  createdAt      DateTime @default(now())

  institution  Institution   @relation(fields: [institutionId], references: [id])
  section      Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId], references: [id])
  teacher      User          @relation("TimetableTeacher", fields: [teacherId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@index([sectionId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@map("timetable_slots")
}

// ---------- Examinations ----------

model Examination {
  id             String   @id @default(uuid()) @db.Uuid
  institutionId  String   @db.Uuid
  name           String
  type           ExamType
  academicYearId String?  @db.Uuid
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())

  institution  Institution    @relation(fields: [institutionId], references: [id])
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id])
  schedules    ExamSchedule[]

  @@index([institutionId])
  @@map("examinations")
}

model ExamSchedule {
  id            String   @id @default(uuid()) @db.Uuid
  examinationId String   @db.Uuid
  classId       String   @db.Uuid
  subjectId     String   @db.Uuid
  date          DateTime @db.Date
  startTime     String? // "HH:mm"
  endTime       String? // "HH:mm"
  totalMarks    Decimal  @db.Decimal(5, 2)
  passingMarks  Decimal  @db.Decimal(5, 2)
  roomNumber    String?
  createdAt     DateTime @default(now())

  examination Examination  @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass  @relation(fields: [classId], references: [id])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  results     ExamResult[]

  @@unique([examinationId, classId, subjectId])
  @@map("exam_schedules")
}

model ExamResult {
  id             String   @id @default(uuid()) @db.Uuid
  examScheduleId String   @db.Uuid
  studentId      String   @db.Uuid
  marksObtained  Decimal? @db.Decimal(5, 2)
  grade          String?
  remarks        String?
  isAbsent       Boolean  @default(false)
  createdAt      DateTime @default(now())

  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examScheduleId, studentId])
  @@index([studentId])
  @@map("exam_results")
}

model GradeScale {
  id            String  @id @default(uuid()) @db.Uuid
  institutionId String  @db.Uuid
  grade         String // "A+", "A", ...
  minPercent    Decimal @db.Decimal(5, 2)
  maxPercent    Decimal @db.Decimal(5, 2)
  gradePoint    Decimal? @db.Decimal(4, 2)
  sortOrder     Int     @default(0)

  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, grade])
  @@map("grade_scales")
}

// ---------- Fees ----------

model FeeStructure {
  id             String   @id @default(uuid()) @db.Uuid
  institutionId  String   @db.Uuid
  name           String
  classId        String?  @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  frequency      String // monthly, quarterly, annually, one-time
  academicYearId String?  @db.Uuid
  dueDay         Int?
  lateFeePerDay  Decimal  @default(0) @db.Decimal(8, 2)
  createdAt      DateTime @default(now())

  institution  Institution   @relation(fields: [institutionId], references: [id])
  schoolClass  SchoolClass?  @relation(fields: [classId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  payments     FeePayment[]

  @@index([institutionId])
  @@map("fee_structures")
}

model FeePayment {
  id             String    @id @default(uuid()) @db.Uuid
  studentId      String    @db.Uuid
  feeStructureId String    @db.Uuid
  amountDue      Decimal   @db.Decimal(12, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(12, 2)
  discount       Decimal   @default(0) @db.Decimal(12, 2)
  lateFee        Decimal   @default(0) @db.Decimal(8, 2)
  status         FeeStatus @default(unpaid)
  dueDate        DateTime  @db.Date
  paidDate       DateTime? @db.Date
  paymentMethod  String? // cash, online, cheque, upi
  transactionId  String?
  receiptNumber  String?   @unique
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("fee_payments")
}

// ---------- Transport ----------

model TransportRoute {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  name          String
  vehicleNumber String?
  driverName    String?
  driverPhone   String?
  capacity      Int?
  createdAt     DateTime @default(now())

  institution Institution     @relation(fields: [institutionId], references: [id])
  stops       TransportStop[]

  @@index([institutionId])
  @@map("transport_routes")
}

model TransportStop {
  id         String   @id @default(uuid()) @db.Uuid
  routeId    String   @db.Uuid
  name       String
  pickupTime String? // "HH:mm"
  dropTime   String? // "HH:mm"
  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)
  orderIndex Int
  createdAt  DateTime @default(now())

  route    TransportRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students StudentTransport[]

  @@index([routeId])
  @@map("transport_stops")
}

model StudentTransport {
  id             String  @id @default(uuid()) @db.Uuid
  studentId      String  @db.Uuid
  stopId         String  @db.Uuid
  academicYearId String? @db.Uuid

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stop         TransportStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@map("student_transport")
}

// ---------- Library ----------

model LibraryBook {
  id              String     @id @default(uuid()) @db.Uuid
  institutionId   String     @db.Uuid
  title           String
  author          String
  isbn            String?    @unique
  publisher       String?
  category        String?
  edition         String?
  totalCopies     Int        @default(1)
  availableCopies Int        @default(1)
  shelfLocation   String?
  coverImageUrl   String?
  status          BookStatus @default(available)
  createdAt       DateTime   @default(now())

  institution  Institution          @relation(fields: [institutionId], references: [id])
  transactions LibraryTransaction[]

  @@index([institutionId])
  @@map("library_books")
}

model LibraryTransaction {
  id         String           @id @default(uuid()) @db.Uuid
  bookId     String           @db.Uuid
  userId     String           @db.Uuid
  issueDate  DateTime         @default(now()) @db.Date
  dueDate    DateTime         @db.Date
  returnDate DateTime?        @db.Date
  fineAmount Decimal          @default(0) @db.Decimal(8, 2)
  status     LibraryTxnStatus @default(issued)
  createdAt  DateTime         @default(now())

  book LibraryBook @relation(fields: [bookId], references: [id])
  user User        @relation(fields: [userId], references: [id])

  @@index([bookId])
  @@index([userId])
  @@map("library_transactions")
}

// ---------- Hostel ----------

model HostelRoom {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  blockName     String
  roomNumber    String
  floor         Int?
  capacity      Int
  occupied      Int      @default(0)
  roomType      String? // single, double, dormitory
  monthlyFee    Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  institution Institution        @relation(fields: [institutionId], references: [id])
  allocations HostelAllocation[]

  @@unique([institutionId, blockName, roomNumber])
  @@map("hostel_rooms")
}

model HostelAllocation {
  id             String    @id @default(uuid()) @db.Uuid
  roomId         String    @db.Uuid
  studentId      String    @db.Uuid
  academicYearId String?   @db.Uuid
  checkInDate    DateTime? @db.Date
  checkOutDate   DateTime? @db.Date
  createdAt      DateTime  @default(now())

  room         HostelRoom    @relation(fields: [roomId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@map("hostel_allocations")
}

// ---------- Communication ----------

model Announcement {
  id             String        @id @default(uuid()) @db.Uuid
  institutionId  String        @db.Uuid
  title          String
  content        String
  type           MessageType   @default(announcement)
  priority       PriorityLevel @default(medium)
  targetRoles    UserRole[]    @default([])
  targetClasses  String[]      @default([]) @db.Uuid
  authorId       String        @db.Uuid
  isPinned       Boolean       @default(false)
  publishedAt    DateTime      @default(now())
  expiresAt      DateTime?
  attachmentUrls String[]      @default([])
  createdAt      DateTime      @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  author      User        @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([institutionId, publishedAt])
  @@map("announcements")
}

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  institutionId   String    @db.Uuid
  senderId        String    @db.Uuid
  recipientId     String    @db.Uuid
  subject         String?
  content         String
  isRead          Boolean   @default(false)
  readAt          DateTime?
  parentMessageId String?   @db.Uuid
  createdAt       DateTime  @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id])
  sender        User        @relation("MessageSender", fields: [senderId], references: [id])
  recipient     User        @relation("MessageRecipient", fields: [recipientId], references: [id])
  parentMessage Message?    @relation("MessageThread", fields: [parentMessageId], references: [id])
  replies       Message[]   @relation("MessageThread")

  @@index([recipientId, isRead])
  @@index([senderId])
  @@map("messages")
}

// ---------- HR & Payroll ----------

model LeaveRequest {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  leaveType    String // sick, casual, earned, maternity...
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  reason       String?
  status       LeaveStatus @default(pending)
  approvedById String?     @db.Uuid
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())

  user       User  @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}

model Payroll {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  month         Int
  year          Int
  basicSalary   Decimal       @db.Decimal(12, 2)
  allowances    Decimal       @default(0) @db.Decimal(12, 2)
  deductions    Decimal       @default(0) @db.Decimal(12, 2)
  netSalary     Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime?     @db.Date
  paymentStatus PayrollStatus @default(pending)
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("payroll")
}

// ---------- Assignments ----------

model Assignment {
  id             String   @id @default(uuid()) @db.Uuid
  institutionId  String   @db.Uuid
  title          String
  description    String?
  subjectId      String   @db.Uuid
  classId        String   @db.Uuid
  sectionId      String?  @db.Uuid
  teacherId      String   @db.Uuid
  dueDate        DateTime
  maxMarks       Decimal? @db.Decimal(5, 2)
  attachmentUrls String[] @default([])
  createdAt      DateTime @default(now())

  institution Institution            @relation(fields: [institutionId], references: [id])
  subject     Subject                @relation(fields: [subjectId], references: [id])
  schoolClass SchoolClass            @relation(fields: [classId], references: [id])
  section     Section?               @relation(fields: [sectionId], references: [id])
  teacher     User                   @relation("AssignmentTeacher", fields: [teacherId], references: [id])
  submissions AssignmentSubmission[]

  @@index([institutionId])
  @@index([teacherId])
  @@map("assignments")
}

model AssignmentSubmission {
  id             String    @id @default(uuid()) @db.Uuid
  assignmentId   String    @db.Uuid
  studentId      String    @db.Uuid
  content        String?
  attachmentUrls String[]  @default([])
  marksObtained  Decimal?  @db.Decimal(5, 2)
  feedback       String?
  submittedAt    DateTime  @default(now())
  gradedAt       DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

// ---------- Inventory / Visitors ----------

model InventoryItem {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  name          String
  category      String?
  quantity      Int      @default(0)
  unit          String?
  unitPrice     Decimal? @db.Decimal(12, 2)
  minStockAlert Int      @default(5)
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
  @@map("inventory_items")
}

model VisitorLog {
  id            String    @id @default(uuid()) @db.Uuid
  institutionId String    @db.Uuid
  visitorName   String
  phone         String?
  purpose       String
  whomToMeet    String?
  checkIn       DateTime  @default(now())
  checkOut      DateTime?
  idProofType   String?
  idProofNumber String?
  createdAt     DateTime  @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
  @@map("visitor_logs")
}

// ---------- Files ----------

// Uploaded files (assignment PDFs, photos, announcement attachments) stored
// as bytea so the app stays deployable on hosts without a writable disk
// (Vercel). Served through /api/files/[id] with auth + institution scoping.
model StoredFile {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  uploaderId    String   @db.Uuid
  name          String
  mimeType      String
  size          Int
  data          Bytes
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  uploader    User        @relation("StoredFileUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("stored_files")
}

// ---------- Notifications / Audit ----------

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  message   String
  type      String // attendance, fee, announcement, assignment, result, general
  isRead    Boolean  @default(false)
  actionUrl String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  tableName String
  recordId  String?  @db.Uuid
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([tableName, recordId])
  @@map("audit_logs")
}
